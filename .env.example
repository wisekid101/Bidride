# BidRide — local development environment (Phase P1)
#
#   cp .env.example .env      (or run: pnpm dev:setup)
#
# These are LOCAL DEV values only. No real secret ever belongs in this file or
# in .env. Production values live in AWS Secrets Manager (never in git/state).
# Defaults below assume `docker compose -f docker-compose.dev.yml up -d`.
# `.env` is gitignored.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Postgres (compose: user=bidride pass=bidride_dev). Prisma reads DATABASE_URL.
DATABASE_URL=postgresql://bidride:bidride_dev@localhost:5432/bidride
# Parallel DB used by *.integration.spec.ts (created by postgres-init.sql):
TEST_DATABASE_URL=postgresql://bidride:bidride_dev@localhost:5432/bidride_test

# Redis
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Auth (DEV secrets — not real; HS256 by default, matches current prod alg) ─
# NOTE: dev-only. Rotate/replace for any shared environment. For local RS256
# (B8C) testing, run `pnpm dev:rs256` to generate a keypair + JWT_PUBLIC_KEYS.
JWT_SECRET=dev-only-not-a-real-secret-change-me-0000
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me-0000
INTERNAL_SERVICE_KEY=dev-internal-service-key-000000000000
FOUNDER_SIGNING_PUBLIC_KEY=
ADMIN_SESSION_TTL_SECONDS=28800

# RS256 public-key keysets (empty by default → HS256 dev mode). Populate via
# `pnpm dev:rs256` to exercise the future dual-verify path locally.
JWT_PUBLIC_KEYS=
JWT_ADMIN_PUBLIC_KEYS=

# ─── Inter-service URLs (local ports 3001–3012) ──────────────────────────────
AI_SERVICE_URL=http://localhost:3012
PRICING_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3008
DRIVER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3007
SAFETY_SERVICE_URL=http://localhost:3006
TRUST_SERVICE_URL=http://localhost:3009

# ─── CORS (admin portal + apps run on :3000 locally) ─────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_WS_ORIGINS=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3000

# ─── Object storage / AWS ────────────────────────────────────────────────────
AWS_REGION=us-east-1
# 'dev-placeholder' keeps safety SOS recordings on the built-in LOCAL-DISK dev
# store (no S3 needed) — the simplest working default.
AWS_ACCESS_KEY_ID=dev-placeholder
AWS_SECRET_ACCESS_KEY=dev-placeholder
KMS_RECORDINGS_KEY_ID=dev-local-no-kms
DOCUMENTS_BUCKET=bidride-documents-dev
S3_BUCKET_SOS_AUDIO=bidride-recordings-dev

# LocalStack endpoint (KMS/Secrets/SQS) — used by the dev RS256 workflow.
AWS_ENDPOINT_URL=http://localhost:4566
#
# OPTIONAL — test driver document upload against MinIO instead of local disk:
#   set MinIO creds + S3 endpoint. (MinIO console: http://localhost:9001)
# AWS_ACCESS_KEY_ID=bidride_dev
# AWS_SECRET_ACCESS_KEY=bidride_dev_secret
# AWS_ENDPOINT_URL_S3=http://localhost:9000

# ─── Providers (DEV placeholders — features degrade / OTP prints to console) ──
STRIPE_SECRET_KEY=sk_test_dev_placeholder
STRIPE_WEBHOOK_SECRET=whsec_dev_placeholder
STRIPE_PLATFORM_ACCOUNT_ID=acct_dev_placeholder
TWILIO_ACCOUNT_SID=ACdev_placeholder
TWILIO_AUTH_TOKEN=dev_placeholder
TWILIO_PHONE_NUMBER=+15555550100
TWILIO_PROXY_SERVICE_SID=KSdev_placeholder
CHECKR_API_KEY=dev_placeholder
CHECKR_WEBHOOK_SECRET=dev_placeholder
CHECKR_PACKAGE=driver_standard
FCM_PROJECT_ID=bidride-dev
FCM_SERVICE_ACCOUNT_EMAIL=dev@bidride-dev.iam.gserviceaccount.com
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
FLIGHTAWARE_API_KEY=dev_placeholder
GOOGLE_MAPS_API_KEY=dev_placeholder

# ─── Misc feature flags / tunables ───────────────────────────────────────────
PAYOUTS_ENABLED=false
LOCATION_TTL_SECONDS=30
AIRPORT_RADIUS_METERS=2000
APP_REFRESH_URL=http://localhost:3000/refresh
APP_RETURN_URL=http://localhost:3000/return

# ─── Mobile (Expo) — point apps at your LAN IP for device testing ────────────
# EXPO_PUBLIC_API_URL=http://<your-lan-ip>:8080
