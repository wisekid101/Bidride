# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.expo/
*.tsbuildinfo

# Expo prebuild native projects (generated — never commit)
apps/*/ios/
apps/*/android/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# Test / coverage
coverage/
.nyc_output/

# Prisma generated client (regenerated by prisma generate)
packages/database/generated/

# Turborepo cache
.turbo/

# Playwright
test-results/
playwright-report/

# Terraform state and secrets (never commit)
# Unanchored so they protect EVERY Terraform root, not just the top one.
# infrastructure/terraform/dns/ is a second root; nested roots were previously
# unprotected because these patterns were single-level.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan
crash.log
crash.*.log
terraform.tfvars
# Per-environment variable files hold db_password — only the .example templates
# and the backend .hcl files (which contain no secrets) are tracked.
infrastructure/terraform/env/*.tfvars
!infrastructure/terraform/env/*.tfvars.example
# Deployment records: the exact task-definition ARNs a deploy landed on.
# Generated per run, used as rollback targets, never committed.
infrastructure/deploy-records/

# Dev-only acceptance harness: runtime artifacts + Founder portal creds (never committed)
.dev-artifacts/
.maestro-artifacts/
.env.founder.local
