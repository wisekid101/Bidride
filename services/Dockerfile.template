# Multi-stage build for NestJS services
# Usage: docker build -f services/Dockerfile.template --build-arg SERVICE_NAME=auth-service .

ARG SERVICE_NAME

# ─── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Same reason as the runner stage: @prisma/engines decides WHICH schema engine
# to download during `pnpm install`, using the openssl CLI to detect the version.
# Without it here, detection defaults to openssl-1.1.x and bundles a schema
# engine linked against libssl.so.1.1, which Alpine 3.23 does not provide —
# `prisma migrate deploy` would then try to download the correct engine from
# binaries.prisma.sh at run time. binaryTargets covers the query engine; this
# covers the schema engine.
RUN apk add --no-cache openssl

# Install pnpm
RUN npm install -g pnpm@9

# Copy workspace manifest files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages/ ./packages/

# Copy target service
ARG SERVICE_NAME
COPY services/${SERVICE_NAME}/ ./services/${SERVICE_NAME}/

# The root package.json runs `postinstall: node scripts/dev/link-db-env.mjs`.
# Without scripts/ present, pnpm's postinstall hook exits non-zero with
# "Cannot find module '/app/scripts/dev/link-db-env.mjs'" and the install fails
# for EVERY service. The script is self-guarding — it has no throw and no
# non-zero exit path — so with packages/database/.env absent (as it is here, by
# design) it warns and exits 0. Builder stage only; the runner never copies it.
COPY scripts/ ./scripts/

# Install dependencies (production only for service, full for database package)
RUN pnpm install --frozen-lockfile

# Generate Prisma client
RUN pnpm --filter @bidride/database generate

# Build @bidride/observability BEFORE the service.
#
# It declares `main: dist/index.js` + `types: dist/index.d.ts`, and is a compile
# AND runtime dependency of all 12 services. But packages/observability/dist is
# NOT tracked in git, and .dockerignore deliberately admits it into the build
# context so the runner stage has something to copy — so the build depended on
# whether the host happened to have run `pnpm build` at some point.
#
# On a clean checkout or a CI runner that directory does not exist, and the
# build FAILS HARD (verified by removing dist and building the previous
# Dockerfile):
#
#   src/app.module.ts:12:8 - error TS2307: Cannot find module
#     '@bidride/observability/nest' or its corresponding type declarations.
#   ERROR: process "pnpm --filter @bidride/<svc> build" ... exit code: 1
#
# It fails rather than shipping a broken image because there is no nest-cli.json,
# so `nest build` uses the tsc builder and type-checks. That is the good outcome
# — but it means image builds were impossible anywhere except a machine that had
# already built the package locally, which is every CI runner.
#
# `pnpm --filter <svc> build` does NOT build dependencies, so this cannot be left
# implicit. Building observability here makes the image hermetic: the dist inside
# the image is always compiled from the source inside the image.
RUN pnpm --filter @bidride/observability build

# Build target service
RUN pnpm --filter @bidride/${SERVICE_NAME} build

# ─── Stage 2: Runner ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

# openssl supplies the CLI that @prisma/get-platform uses to detect the OpenSSL
# version. Without it detection fails, defaults to openssl-1.1.x, and the Prisma
# client loads the WRONG engine filename even when the OpenSSL 3 engine is
# present. libssl3/libcrypto3 are already base-image dependencies, so this adds
# the detection binary only, not a new cryptographic library.
RUN apk add --no-cache dumb-init curl openssl

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Copy built artifacts
#
# dist is COLOCATED with the service's own node_modules, not placed at /app/dist.
# pnpm keeps each workspace package's dependencies under that package, so with
# dist at /app/dist Node resolved from /app/dist/main.js → /app/dist/node_modules
# → /app/node_modules → /node_modules and never reached
# /app/services/<service>/node_modules. /app/node_modules holds only hoisted root
# dev tooling, so every service died at boot with:
#   Error: Cannot find module '@nestjs/core' — Require stack: /app/dist/main.js
# The WORKDIR below matches this directory, and pnpm's relative symlinks
# (../../../../node_modules/.pnpm/…) continue to resolve from here.
ARG SERVICE_NAME
COPY --from=builder --chown=nestjs:nodejs /app/services/${SERVICE_NAME}/dist ./services/${SERVICE_NAME}/dist
# @bidride/observability is a RUNTIME dependency of all 12 services
# (`import … from '@bidride/observability/nest'`). Each service's
# node_modules/@bidride/observability is a pnpm symlink to
# ../../../../packages/observability, so without this copy the link dangles and
# the service dies with MODULE_NOT_FOUND for '@bidride/observability/nest'.
# Its dist is prebuilt (the image never builds this package), and the whole
# package is ~428 KB. jest-preset is deliberately NOT copied — its symlink also
# dangles, but nothing imports it at run time, only tests.
COPY --from=builder --chown=nestjs:nodejs /app/packages/observability ./packages/observability
COPY --from=builder --chown=nestjs:nodejs /app/packages/database/generated ./packages/database/generated
# Copy Prisma schema and migrations so ECS run-task migration overrides work
COPY --from=builder --chown=nestjs:nodejs /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/services/${SERVICE_NAME}/node_modules ./services/${SERVICE_NAME}/node_modules

# Run from the service directory so `node dist/main` finds dist/ and Node's
# resolver walks services/<service>/node_modules first, then /app/node_modules.
# The Prisma paths above stay absolute-safe: the migration override already uses
# /app/... explicitly, so it is unaffected by this working directory.
WORKDIR /app/services/${SERVICE_NAME}

USER nestjs

ARG PORT=3001
EXPOSE $PORT

# dumb-init handles signal forwarding for graceful shutdown
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main"]

# ECS task definition healthCheck overrides this at runtime with the correct port.
# This HEALTHCHECK is only used when running the container standalone (local testing).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -sf http://localhost:${PORT:-3001}/health || exit 1
