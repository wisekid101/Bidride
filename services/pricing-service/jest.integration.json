{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.integration\\.spec\\.ts$",
  "setupFiles": [
    "<rootDir>/../test/integration-setup.js"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "isolatedModules": true
      }
    ]
  },
  "moduleNameMapper": {
    "^@bidride/database$": "<rootDir>/../../../packages/database/generated/client",
    "^@bidride/database/generated/client$": "<rootDir>/../../../packages/database/generated/client"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 2
}
